# ==============================================================================
# BEACON Environment & Path Configuration Template
# Copy this file to .env and adjust variables to match your local installation.
# ==============================================================================

# EnergyPlus Simulation Engine
ENERGYPLUS_DIR=C:\EnergyPlusV26-1-0
ENERGYPLUS_EXE=C:\EnergyPlusV26-1-0\energyplus.exe

# Local Ollama AI Model Runtime
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Telemetry & Dashboard Server
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
TELEMETRY_STREAM_INTERVAL_SECONDS=1.0

# Logging & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
